{
  "name": "fika-platform",
  "version": "0.2.0",
  "private": true,
  "description": "FIKA - intercity bus booking, parcel delivery and operations platform for Rwanda (passenger PWA, operator portal, station desk, admin dashboard, API).",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev -p 4544",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web": "next build",
    "build:api": "tsc -p tsconfig.server.json",
    "start": "node scripts/start.mjs",
    "start:web": "next start -p 4545",
    "start:api": "node dist/server/index.js",
    "db:migrate": "tsx server/migrations/run.ts up",
    "db:rollback": "tsx server/migrations/run.ts down",
    "db:setup": "tsx server/seed/setup.ts",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "jose": "^6.2.13",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.577.0",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "next": "16.1.6",
    "nodemailer": "^10.2.1",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
