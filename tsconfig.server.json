{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "noEmit": false
  },
  "include": ["server/**/*.ts", "server/**/*.json", "shared/**/*.ts"],
  "exclude": ["node_modules", "dist", "legacy", "tests"]
}
