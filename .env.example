# ─────────────────────────────────────────────────────────────────────────────
# FIKA platform configuration. Copy to `.env` and adjust. Never commit real secrets.
# Every integration below is optional in development: without credentials the
# platform uses built-in mock providers (console SMS/email, mock mobile money).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Web (Next.js) ────────────────────────────────────────────────────────────
# Where the web app proxies /api/* requests (server-side).
API_URL=http://localhost:4000
# Socket.io endpoint used by browsers. Defaults to <current host>:4000 when empty.
NEXT_PUBLIC_SOCKET_URL=

# ── API server ───────────────────────────────────────────────────────────────
API_PORT=4000
# Public URL of the web app (used for OAuth redirects and links in SMS/email).
WEB_URL=http://localhost:4544
# Comma-separated browser origins allowed to call the API / open sockets directly.
CORS_ORIGINS=http://localhost:4544,http://127.0.0.1:4544
# Set to 1 when running behind a reverse proxy / load balancer.
TRUST_PROXY=0

# ── Database (MongoDB Atlas) ─────────────────────────────────────────────────
# Your Atlas connection string (Atlas → Connect → Drivers), e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fika?retryWrites=true&w=majority
# Remember to allow your IP address in Atlas → Network Access. Put the real string in .env only:
# this file is committed.
# If the API fails with "querySrv ECONNREFUSED", Node cannot do the SRV DNS lookup on your network.
# Use the same cluster's hosts instead (resolve _mongodb._tcp.<cluster>.mongodb.net for the list):
#   mongodb://<user>:<password>@<host1>:27017,<host2>:27017,<host3>:27017/?tls=true&replicaSet=<set>&authSource=admin
# Set up a new database once with `npm run db:setup` (indexes, bus parks, RURA fare caps and your
# admin account). The API never adds data to it on its own.
MONGODB_URI=
# Optional: database name when the URI does not include one (defaults to "fika").
MONGODB_DB_NAME=Tega
# Only when MONGODB_URI is empty: a local MongoDB (./.data/mongo) is started and set up with the
# bus parks and RURA fare caps (no accounts or operators). Useful for offline work.
# The local MongoDB version. MongoDB 5.0+ needs a CPU with AVX instructions; on older or low-power
# CPUs (e.g. Intel Celeron / Pentium N-series) it crashes with code 14. Use 4.4.29 there and delete
# .data/mongo, which a newer version created and 4.4 cannot read.
# MONGOMS_VERSION=4.4.29

# ── Security ─────────────────────────────────────────────────────────────────
# Long random strings (32+ chars). REQUIRED in production.
JWT_SECRET=
TICKET_SECRET=
# Access token lifetime in seconds, refresh token lifetime in days.
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=30

# ── SMS (OTP, confirmations, reminders) ──────────────────────────────────────
# console | africastalking
SMS_PROVIDER=console
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=true

# ── Email (OTP fallback, receipts) ───────────────────────────────────────────
# console | smtp
EMAIL_PROVIDER=console
EMAIL_FROM="FIKA <no-reply@fika.rw>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Google OAuth (passenger social login) ────────────────────────────────────
# Authorised redirect URI to register in Google Cloud: <WEB_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Mobile money ─────────────────────────────────────────────────────────────
# mock | live. "live" is only used when the matching credentials are present.
PAYMENTS_MTN_MODE=mock
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENV=sandbox
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_CALLBACK_URL=

PAYMENTS_AIRTEL_MODE=mock
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=

# Shared secret providers (or your gateway) must send in the X-Webhook-Secret header.
PAYMENT_WEBHOOK_SECRET=
# Mock provider: milliseconds before a pending payment settles.
MOCK_PAYMENT_DELAY_MS=4000

# ── File storage (operator & vehicle documents) ──────────────────────────────
# local | s3  (any S3-compatible service: AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ── Background jobs ──────────────────────────────────────────────────────────
JOBS_ENABLED=true
